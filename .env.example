# Endereço da API do Zelo. Copie para .env e reinicie o Expo (npx expo start -c).
# Emulador Android: http://10.0.2.2:3333 | iOS/web no mesmo computador: http://localhost:3333
# Celular de verdade: use o IP do computador na rede, ex.: http://192.168.0.10:3333
EXPO_PUBLIC_API_URL=http://localhost:3333
